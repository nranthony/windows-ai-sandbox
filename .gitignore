# environmental user information
.env
*.env
# but keep committed templates/examples
!*.env.template
!*.env.example
# local shells for personal setup
.local*
# fashion mnist testing data
data/

# personal-project / workload docs (kept locally, not published to this public repo)
# (matches at any depth, e.g. a top-level "*-setup.md" or a "docs/*-setup.md")
*-setup.md

**.pyc
**/**.pyc

# python / node build artifacts
__pycache__/
.venv/
.pytest_cache/
*.egg-info/
node_modules/

# secrets / credentials (never commit — templates excepted above)
*.pem
*.key
id_rsa*
.netrc
credentials.json
*.token

# Agent-native local configurations (per-machine overrides, never committed)
AGENTS.local.md
**/AGENTS.local.md
**/*.local.json
.claude/settings.local.json
# where agentic-conventions is checked out on THIS machine — the only
# machine-specific fact in the CONTENT half of vendor-tools.sh --check
.conventions-dir.local
# same, for the myclickup checkout (vendor-tools.sh --check content diff)
.myclickup-dir.local
# same, for the paperbridge checkout (work/0026). One pointer per member repo:
# vendor-tools.sh `member_pointer` maps a manifest source_repo to its line here,
# and a source_repo with no mapping degrades the content half to HASH-ONLY.
.paperbridge-dir.local
# the depot CHANNEL ROOT — the directory holding manifest.toml, dist/ and bin/
# (scripts/vendor-tools.sh, ADR-0014). This is the channel, not a member repo,
# and it does NOT supersede the two pointers above: the channel supplies the
# artifacts, those supply the SOURCE the content half diffs them against.
.depot-dir.local
# real client/project names to scan for on public-repo surfaces
# (scripts/private-names-check.sh, work/0007) — never committed, since the
# names living in the tracked tree is exactly what the check exists to catch
.private-names.local

# vendored myclickup payload — NEVER commit. This repo is public and
# nranthony/myclickup is private; a py3-none-any wheel is a zip of the .py
# files, so committing it would publish the tool's source. The Dockerfile
# installs it conditionally, so a clone without the payload still builds — it
# just has no `myclickup`. Regenerate with `just vendor-tools`.
sandbox_templates/wheels/*.whl
sandbox_templates/skills/myclickup/
# but keep the directory in the Docker build context: a COPY of a missing
# directory fails the build for everyone (see the myclickup block in Dockerfile)
!sandbox_templates/wheels/.gitkeep
#
# paperbridge (work/0026) is DELIBERATELY ABSENT from the skills line above, and
# the asymmetry is the point rather than an oversight: nranthony/paperbridge is
# PUBLIC, so the disclosure argument that gitignores skills/myclickup/ does not
# apply and its SKILL.md is tracked. The wheel rule above is blanket by design
# and still covers it — wheels stay out of git because VENDORED.lock is the
# committed record of what an image contained, not because of who may read them.
#
# Host-built wheels for packages PyPI publishes as sdist only (Gate 3 refuses to
# build those at image time). Not channel artifacts: kept OUT of wheels/ so they
# never enter vendor-tools.sh's rotation or the Dockerfile's per-artifact "two
# wheels is a refusal" count. Their sha256 is recorded beside them and checked
# in the Dockerfile before install. Regenerate per work/0026 plan.md P7.
sandbox_templates/wheels-host/*.whl
!sandbox_templates/wheels-host/.gitkeep

# native plan-mode drafts (plansDirectory in .claude/settings.json) — drafts, not the
# durable artifact; a draft becomes durable by promotion to work/NNNN-slug/plan.md
work/plans/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
